; One two-bit pulser state machine for the schematic truth table:
;   GPIO27(A) GPIO28(B) = 00 idle, 10 negative, 11 damping, 01 positive.
; PIO numeric values (GPIO27 is the low bit) are therefore:
;   0 idle, 1 negative, 3 damping, 2 positive.
;
; Four FIFO words are supplied per pulse: order, first-count, damp-count,
; third-count. Counts are compensated in C for instruction overhead so each
; requested state lasts its requested number of 8 ns PIO ticks.
.program u4rk_pulser

.wrap_target
entry:
    pull block
    mov x, osr
    jmp !x negative_first

positive_first:
    pull block
    mov x, osr
    pull block
    mov y, osr
    set pins, 2
positive_loop:
    jmp x-- positive_loop
    set pins, 3
    pull block
    mov x, osr
positive_damp_loop:
    jmp y-- positive_damp_loop
    set pins, 1
positive_last_loop:
    jmp x-- positive_last_loop
    set pins, 0
    jmp entry

negative_first:
    pull block
    mov x, osr
    pull block
    mov y, osr
    set pins, 1
negative_loop:
    jmp x-- negative_loop
    set pins, 3
    pull block
    mov x, osr
negative_damp_loop:
    jmp y-- negative_damp_loop
    set pins, 2
negative_last_loop:
    jmp x-- negative_last_loop
    set pins, 0
    jmp entry
.wrap

% c-sdk {
static inline void u4rk_pulser_program_init(PIO pio, uint sm, uint offset,
                                            float instruction_hz) {
    pio_sm_config config = u4rk_pulser_program_get_default_config(offset);
    pio_gpio_init(pio, U4RK_PULSER_PIN_BASE);
    pio_gpio_init(pio, U4RK_PULSER_PIN_BASE + 1);
    sm_config_set_set_pins(&config, U4RK_PULSER_PIN_BASE, 2);
    sm_config_set_clkdiv(&config,
        (float)clock_get_hz(clk_sys) / instruction_hz);
    pio_sm_set_consecutive_pindirs(pio, sm, U4RK_PULSER_PIN_BASE, 2, true);
    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_enabled(pio, sm, false);
    pio_sm_set_pins_with_mask(
        pio, sm, 0u, 3u << U4RK_PULSER_PIN_BASE);
}
%}
